{
  // Written out by tools/publish.mjs as "<target>.code-workspace" — week-05-layout-grid is replaced
  // with the folder name (e.g. week-01-html-git.code-workspace).
  //
  // Why ship a workspace file at all: opening a single FILE in VS Code gives the wrong
  // root, so Live Server serves from the wrong directory and every relative path breaks.
  // Double-clicking this file always opens the correct folder as the root.
  "folders": [
    {
      "name": "week-05-layout-grid",
      "path": "."
    }
  ],
  "settings": {
    // The folder's own .vscode/settings.json still applies; these are workspace-level
    // and only cover what a settings.json cannot.
    "files.eol": "\n",
    "editor.formatOnSave": true
  },
  "extensions": {
    "recommendations": [
      "ritwickdey.liveserver",
      "esbenp.prettier-vscode",
      "dbaeumer.vscode-eslint",
      "bradlc.vscode-tailwindcss",
      "usernamehw.errorlens",
      "htmlhint.vscode-htmlhint",
      "eamodio.gitlens",
      "christian-kohler.path-intellisense"
    ]
  }
}
