# MANDATORY — CLAUDE_CODE_BRIEF.md §4.2, no exceptions.
#
# The class is mixed Mac and Windows. Without this line every commit from a Windows
# machine shows every line as changed, which:
#   · destroys reviewable diffs (and commit hygiene is a rubric line from week 1)
#   · breaks the auto-grader's file comparisons
#   · makes the week-13 surgery-exam bug injection unreliable
* text=auto eol=lf

# Binary assets — never normalise, never diff
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.svg  text
*.mp3  binary
*.wav  binary
*.pdf  binary
*.woff  binary
*.woff2 binary
*.ttf  binary
