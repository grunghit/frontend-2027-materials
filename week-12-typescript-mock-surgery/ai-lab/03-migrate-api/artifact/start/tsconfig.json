{
  "$schema": "https://json.schemastore.org/tsconfig",

  /*
    GIVEN AND COMPLETE. You do not change this file — you run it:

      npx tsc -p tsconfig.json          # from this folder

    Sources live in ts/. Output lands in js/, beside the plain-JavaScript modules that
    import it. The browser loads THE OUTPUT and has never heard of TypeScript.

    NOTE ON THE COMMENT STYLE: tsconfig.json is JSONC, so these are real comments. The
    `"//key": "…"` trick used elsewhere in this repo does NOT work inside
    `compilerOptions` — tsc rejects unknown options there by design.
  */
  "compilerOptions": {
    /*
      ES2022 is what every browser in the lab runs. Down-levelling would emit output that
      no longer looks like its source, and reading the emitted file beside the source is
      half of what today is for.
    */
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    /*
      `DOM.Iterable` is separate from `DOM` and you WILL need it. Without it,
      `[...document.querySelectorAll('li')]` is a type error — `NodeListOf` is declared
      without `[Symbol.iterator]` in the base DOM lib, even though every browser has had
      it for a decade. It is the first error most migrations hit and it looks like a
      real problem with the code; it is a missing line here.
    */
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    /*
      STRICT IS THE ENTIRE POINT. With it off, `value.id` on an `unknown` compiles
      happily, every guard stops guarding, and the migration buys you nothing but
      colour in the editor.
    */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    /*
      A type error must not leave a half-written js/api.js on disk for the page to load.
      Fail, change nothing, and say why.
    */
    "noEmitOnError": true,

    "rootDir": "ts",
    "outDir": "js",

    /*
      The emitted .d.ts is what lets the editor type-check the plain-JavaScript modules
      that import from js/ — so render.js and events.js get the types without themselves
      being TypeScript. That is the whole incremental-migration story in one option.
    */
    "declaration": true,
    "removeComments": false,
    "newLine": "lf"
  },

  "include": ["ts/**/*.ts"]
}
