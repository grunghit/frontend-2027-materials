{
  "$schema": "https://json.schemastore.org/tsconfig",

  /*
    The project's only build step, and `tsc` is the ONLY one the course allows
    (brief §1). Run it from this folder:

      npx tsc -p tsconfig.json

    Nothing else in the app is compiled, bundled or transformed — the browser
    loads every .js file exactly as it is on disk. This file is GIVEN and needs no
    changes; `npx tsc -p tsconfig.json` from this folder should just work.

    NOTE ON THE COMMENT STYLE: tsconfig.json is JSONC, so these are real
    comments. The `"//key": "…"` trick used elsewhere in this repo does NOT work
    inside `compilerOptions` — tsc rejects unknown options there by design.
  */
  "compilerOptions": {
    /*
      ES2022 is what every browser in the lab runs. Down-levelling would emit
      output that no longer looks like its source, and reading the emitted file
      beside the source is half of what this module is here to teach.
    */
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],

    /*
      Strict is the reason this module is worth having at all. With it off,
      `value.id` on an `unknown` compiles happily and the guards in types.ts
      stop guarding anything.
    */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,

    /*
      A type error must not leave a half-written js/types.js on disk for the page
      to load. Fail, change nothing, and say why.
    */
    "noEmitOnError": true,

    "rootDir": "ts",
    "outDir": "js",

    /*
      The emitted .d.ts is what lets an editor type-check the plain-JavaScript
      modules that import from js/types.js — so the rest of the app gets the
      types without itself being TypeScript.
    */
    "declaration": true,
    "removeComments": false,
    "newLine": "lf"
  },

  "include": ["ts/**/*.ts"]
}
